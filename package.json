{
  "name": "pretzel-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:report": "node scripts/sim-report.ts",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "perf": "node scripts/perf.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
